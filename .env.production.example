# Copiar a .env en el servidor: cp .env.production.example .env

# Dominio público (con https)
APP_BASE_URL=https://rifa.tudominio.com
CORS_ORIGINS=https://rifa.tudominio.com

# PostgreSQL (usa contraseñas fuertes)
POSTGRES_USER=sorteos
POSTGRES_PASSWORD=cambia_esta_contraseña_db
POSTGRES_DB=sorteos_db

# Autenticación admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia_esta_contraseña_admin
JWT_SECRET=genera_con_openssl_rand_hex_32
JWT_EXPIRE_MINUTES=1440

# Correo SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_app_password
SMTP_FROM=La Rifa <tu_correo@gmail.com>
