# Copiar a: /etc/nginx/sites-available/larifa
# Enlazar: sudo ln -s /etc/nginx/sites-available/larifa /etc/nginx/sites-enabled/
# Probar: sudo nginx -t && sudo systemctl reload nginx

server {
    listen 80;
    server_name rifa.tudominio.com;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# Certbot agregará el bloque SSL automáticamente:
# sudo certbot --nginx -d rifa.tudominio.com
